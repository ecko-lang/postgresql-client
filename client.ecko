# postgres - a PostgreSQL client written in pure Ecko.
#
# No native code: it speaks the v3 wire protocol over std.net's raw sockets,
# with SCRAM-SHA-256 authentication built from std.hash + bytes + bitwise (the
# 4096-round PBKDF2 runs in the interpreter and is still sub-millisecond).
#
# The implementation. main.ecko is the entrypoint and re-exports the public
# verbs from here; the rest stays internal to the package even though it
# is `export`ed, because the offline tests import this file directly to check
# PBKDF2 and the bind encoding against the published vectors.

import std.net
import std.io
import std.hash
import std.encoding
import std.uuid

# --- big-endian integers ---------------------------------------------------

fn i32(n) = bytes([n shr 24 band 255, n shr 16 band 255, n shr 8 band 255, n band 255])
fn i16(n) = bytes([n shr 8 band 255, n band 255])

# Signed read: Postgres uses Int32 -1 (0xFFFFFFFF) for "null" and lengths.
fn read_i32(b, off) {
    v = b[off] shl 24 bor b[off + 1] shl 16 bor b[off + 2] shl 8 bor b[off + 3]
    if v >= 2147483648 { v - 4294967296 } else { v }
}

fn read_i16(b, off) = b[off] shl 8 bor b[off + 1]

# --- errors ----------------------------------------------------------------

# Every failure this package raises: std.sql's `sql` kind, so one `catch` arm
# covers every database, with `driver` saying which one. `code` is the server's
# SQLSTATE when it sent one (`23505` is a unique violation).
fn fail(message, code = null) {
    if is_null(code) {
        error({ kind: "sql", driver: "postgres", message: message })
    } else {
        error({ kind: "sql", driver: "postgres", message: message, code: code })
    }
}

# --- message framing -------------------------------------------------------
# A backend/frontend message is a 1-byte type + Int32 length (length counts
# itself but not the type byte) + payload. The startup message has no type.

fn send_msg(sock, typ, payload) {
    io.write(sock, bytes(typ) + i32(len(payload) + 4) + payload)
}

# `io.read_exact` answers null when the peer closed with nothing pending. A
# backend that goes away mid-conversation is ordinary, so that null is turned
# into an error here rather than being indexed into further down.
fn read_exact_or_fail(sock, n) {
    b = io.read_exact(sock, n)
    if is_null(b) { fail("the server closed the connection") }
    b
}

fn read_msg(sock) {
    header = read_exact_or_fail(sock, 5)
    typ = string(header[0..1])
    length = read_i32(header, 1)
    payload = if length > 4 { read_exact_or_fail(sock, length - 4) } else { b"" }
    { tag: typ, payload: payload }
}

# The value of a "k=v,..." field (SCRAM messages).
fn field(s, key) {
    p = key + "="
    start = index_of(s, p) + len(p)
    rest = s[start..len(s)]
    end = index_of(rest, ",")
    if end == -1 { rest } else { rest[0..end] }
}

# --- ErrorResponse ('E') / NoticeResponse ('N') -----------------------------
# Both are null-terminated <fieldtype><value> pairs: M is the message, C the
# SQLSTATE code.

fn parse_fields(payload) {
    mut off = 0
    mut out = {}
    while off < len(payload) and payload[off] != 0 {
        code = string(payload[off..off + 1])
        off = off + 1
        start = off
        while payload[off] != 0 {
            off = off + 1
        }
        out = insert(out, code, string(payload[start..off]))
        off = off + 1
    }
    out
}

# Raise an ErrorResponse as this package's error.
fn fail_response(payload) {
    f = parse_fields(payload)
    fail(get(f, "M") ?? "unknown error", get(f, "C"))
}

# --- SCRAM-SHA-256 ----------------------------------------------------------

## PBKDF2-HMAC-SHA256, single 32-byte block (SCRAM's dkLen).
export fn pbkdf2(password, salt, iters) {
    mut u = hash.hmac_sha256_bytes(password, salt + b"\x00\x00\x00\x01")
    mut acc = u
    mut i = 1
    while i < iters {
        u = hash.hmac_sha256_bytes(password, u)
        acc = acc bxor u
        i = i + 1
    }
    acc
}

# Drive the SASL exchange until AuthenticationOk. The intermediate state (our
# nonce and client-first-bare) is held in mut locals across the R messages.
#
# No username here on purpose: SCRAM-SHA-256 sends an empty `n=` in the
# client-first message (RFC 5802 §5.1), because the server already took the
# user from the startup packet. Passing one in would be dead weight.
fn authenticate(sock, password) {
    mut client_first_bare = ""
    mut authed = false
    while authed == false {
        msg = read_msg(sock)
        if msg.tag == "E" { fail_response(msg.payload) }
        code = read_i32(msg.payload, 0)
        if code == 0 { authed = true } else {
            if code == 10 {
                # AuthenticationSASL: send the client-first message.
                nonce = uuid.v4()
                client_first_bare = "n=,r=" + nonce
                client_first = "n,," + client_first_bare
                cf = bytes(client_first)
                send_msg(sock, "p", bytes("SCRAM-SHA-256") + b"\x00" + i32(len(cf)) + cf)
            } else {
                if code == 11 {
                    # AuthenticationSASLContinue: server-first -> client-final.
                    server_first = string(msg.payload[4..len(msg.payload)])
                    full_nonce = field(server_first, "r")
                    salt = encoding.base64_decode(field(server_first, "s"))
                    iters = int(field(server_first, "i"))

                    salted = pbkdf2(bytes(password), salt, iters)
                    client_key = hash.hmac_sha256_bytes(salted, bytes("Client Key"))
                    stored_key = hash.sha256_bytes(client_key)
                    client_final_bare = "c=biws,r=" + full_nonce
                    auth_message = client_first_bare + "," + server_first + "," + client_final_bare
                    client_sig = hash.hmac_sha256_bytes(stored_key, bytes(auth_message))
                    proof = client_key bxor client_sig
                    client_final = client_final_bare + ",p=" + encoding.base64_encode(proof)
                    send_msg(sock, "p", bytes(client_final))
                } else {
                    if code == 12 {
                        # AuthenticationSASLFinal: server signature (trusted).
                        0
                    } else { fail("unsupported auth method (code " + string(code) + ")") }
                }
            }
        }
    }
}

# --- startup + connect -----------------------------------------------------

fn send_startup(sock, user, database) {
    params = bytes("user") +
        b"\x00" +
        bytes(user) +
        b"\x00" +
        bytes("database") +
        b"\x00" +
        bytes(database) +
        b"\x00" +
        b"\x00"
    body = i32(196608) + params
    io.write(sock, i32(len(body) + 4) + body)
}

# Read ParameterStatus/BackendKeyData/... until ReadyForQuery ('Z').
fn drain_until_ready(sock) {
    mut ready = false
    while ready == false {
        msg = read_msg(sock)
        if msg.tag == "Z" { ready = true }
        if msg.tag == "E" { fail_response(msg.payload) }
    }
}

fn handshake(sock, cfg) {
    send_startup(sock, cfg.user, cfg.database)
    authenticate(sock, cfg.password)
    drain_until_ready(sock)
    sock
}

## connect({ host, port, user, password, database }) -> a connection handle.
export fn connect(cfg) = handshake(net.connect(cfg.host, cfg.port), cfg)
## Connect to PostgreSQL over TLS and complete authentication. Same `cfg` as
## `connect`. Needs the `net` capability.
export fn connect_tls(cfg) = handshake(net.connect_tls(cfg.host, cfg.port), cfg)
## Close the connection.
export fn close(sock) = io.close(sock)

# --- simple query ----------------------------------------------------------

# RowDescription ('T'): Int16 field count, then per field a null-terminated
# name followed by 18 bytes of metadata (OIDs, sizes) we don't need.
fn parse_columns(payload) {
    n = read_i16(payload, 0)
    mut off = 2
    mut cols = []
    mut i = 0
    while i < n {
        start = off
        while payload[off] != 0 {
            off = off + 1
        }
        cols = push(cols, string(payload[start..off]))
        off = off + 1 + 18
        i = i + 1
    }
    cols
}

# DataRow ('D'): Int16 column count, then per column Int32 length (-1 = null)
# + value bytes (text format).
fn parse_row(payload, cols) {
    n = read_i16(payload, 0)
    mut off = 2
    mut row = {}
    mut i = 0
    while i < n {
        vlen = read_i32(payload, off)
        off = off + 4
        if vlen == -1 { row[cols[i]] = null } else {
            row[cols[i]] = string(payload[off..off + vlen])
            off = off + vlen
        }
        i = i + 1
    }
    row
}

# Read backend messages until ReadyForQuery ('Z'): the rows, the last
# CommandComplete tag ("COMMIT", "INSERT 0 1", ...) and the SQLSTATE of every
# notice. Shared by the simple and extended query paths (ParseComplete '1' /
# BindComplete '2' / NoData 'n' are read and ignored).
#
# An ErrorResponse is raised only once ReadyForQuery has been read. The server
# always sends one after the error, and raising early left it queued on the
# socket, where the next query on the connection read it as its own reply.
fn read_response(sock) {
    mut cols = []
    mut rows = []
    mut tag = ""
    mut notices = []
    mut err = null
    mut done = false
    while done == false {
        msg = read_msg(sock)
        if msg.tag == "T" { cols = parse_columns(msg.payload) }
        if msg.tag == "D" { rows = push(rows, parse_row(msg.payload, cols)) }
        if msg.tag == "C" { tag = string(msg.payload[0..len(msg.payload) - 1]) }
        if msg.tag == "N" { notices = push(notices, get(parse_fields(msg.payload), "C") ?? "") }
        if msg.tag == "E" and is_null(err) { err = msg.payload }
        if msg.tag == "Z" { done = true }
    }
    unless is_null(err) { fail_response(err) }
    { rows: rows, tag: tag, notices: notices }
}

# --- parameterized queries (extended protocol) -----------------------------
## Text format for every param: the value goes out-of-band as a length-prefixed
## field, NEVER spliced into the SQL, so it can't break out of its slot. That's
## injection safety by construction - the same guarantee as a `?` placeholder.
export fn pg_text(v) {
    t = type_of(v)
    if t == "bool" {
        if v { "t" } else { "f" }
    } else if t == "bytes" {
        "\\x" + encoding.hex_encode(v)
    } else {
        string(v)
    }
}

## build_bind(params) -> the Bind ('B') message payload: unnamed portal + unnamed
## statement + 0 param format codes (all text) + Int16 param count + each param
## (Int32 length, then bytes; length -1 = SQL NULL) + 0 result format codes.
export fn build_bind(params) {
    mut b = b"\x00" + b"\x00" + i16(0) + i16(len(params))
    for p in params {
        if is_null(p) { b = b + b"\xff\xff\xff\xff" } else {
            pb = bytes(pg_text(p))
            b = b + i32(len(pb)) + pb
        }
    }
    b + i16(0)
}

## query(sock, sql) runs a simple text query. query(sock, sql, params) runs the
## extended protocol with $1..$N placeholders bound out-of-band (injection-safe).
## A `sql { }` block works in place of the string and the list: its `?`
## placeholders are numbered for Postgres.
export fn query(sock, sql, params = []) {
    s = statement(sql, params)
    if len(s.params) == 0 {
        send_msg(sock, "Q", bytes(s.sql) + b"\x00")
        return read_response(sock).rows
    }
    # Parse: unnamed statement, the SQL, 0 declared param types (server infers).
    send_msg(sock, "P", b"\x00" + bytes(s.sql) + b"\x00" + i16(0))
    send_msg(sock, "B", build_bind(s.params))
    send_msg(sock, "D", bytes("P") + b"\x00")  # Describe the portal
    send_msg(sock, "E", b"\x00" + i32(0))  # Execute, all rows
    send_msg(sock, "S", b"")  # Sync
    read_response(sock).rows
}

## The SQL text and params `query` sends, from either form it takes: a string
## with `$n` placeholders and a list, sent as written; or a `sql { }` block,
## whose `?` placeholders become `$1..$N`.
export fn statement(sql, params) {
    t = type_of(sql)
    if t == "string" { return { sql: sql, params: params } }
    if t != "map" or is_null(get(sql, "query")) {
        fail("query takes a SQL string or a sql \{ } block, not {t}")
    }
    if len(params) > 0 {
        fail("a sql \{ } block carries its own params; pass it alone, as query(db, sql \{ ... })")
    }
    holes = sql.params
    n = numbered(sql.query)
    if n.count != len(holes) {
        fail(
            "the sql block has {len(holes)} value(s) but its text has {n.count} ? placeholders. A ? that is not a value, such as the jsonb ? operator, cannot be told apart from one in a block: use jsonb_exists(), or a string with $n placeholders",
        )
    }
    { sql: n.sql, params: holes }
}

## `text` with each `?` placeholder numbered `$1`, `$2`, ..., and how many there
## were. A `?` inside a string, a quoted name, a comment or a dollar-quoted body
## is text and stays as it is.
export fn numbered(text) {
    cs = chars(text)
    n = len(cs)
    mut out = ""
    mut count = 0
    mut i = 0
    while i < n {
        c = cs[i]
        if c == "'" {
            # A string. An E'' string escapes with a backslash; any string
            # doubles a quote to include one.
            escapes = i > 0 and (cs[i - 1] == "e" or cs[i - 1] == "E")
            j = quoted_end(cs, i, "'", escapes)
            out = out + join(slice(cs, i, j), "")
            i = j
        } else if c == "\"" {
            j = quoted_end(cs, i, "\"", false)
            out = out + join(slice(cs, i, j), "")
            i = j
        } else if c == "-" and i + 1 < n and cs[i + 1] == "-" {
            mut j = i
            while j < n and cs[j] != "\n" {
                j = j + 1
            }
            out = out + join(slice(cs, i, j), "")
            i = j
        } else if c == "/" and i + 1 < n and cs[i + 1] == "*" {
            # Postgres block comments nest.
            mut depth = 0
            mut j = i
            mut closed = false
            while j < n and not closed {
                if j + 1 < n and cs[j] == "/" and cs[j + 1] == "*" {
                    depth = depth + 1
                    j = j + 2
                } else if j + 1 < n and cs[j] == "*" and cs[j + 1] == "/" {
                    depth = depth - 1
                    j = j + 2
                    if depth == 0 { closed = true }
                } else { j = j + 1 }
            }
            out = out + join(slice(cs, i, j), "")
            i = j
        } else if c == "$" and dollar_tag(cs, i) != "" {
            # $$...$$ or $tag$...$tag$: everything up to the same tag is text.
            tag = chars(dollar_tag(cs, i))
            t = len(tag)
            mut j = i + t
            mut closed = false
            while j < n and not closed {
                if slice(cs, j, min([j + t, n])) == tag {
                    closed = true
                    j = j + t
                } else { j = j + 1 }
            }
            out = out + join(slice(cs, i, j), "")
            i = j
        } else if c == "?" {
            count = count + 1
            out = out + "$" + string(count)
            i = i + 1
        } else {
            out = out + c
            i = i + 1
        }
    }
    { sql: out, count: count }
}

# Index just past the quoted run starting at `start`. A doubled quote stays
# inside it; with `escapes`, so does a backslash and the character after it.
fn quoted_end(cs, start, q, escapes) {
    n = len(cs)
    mut j = start + 1
    while j < n {
        if escapes and cs[j] == "\\" {
            j = j + 2
        } else if cs[j] == q and j + 1 < n and cs[j + 1] == q {
            j = j + 2
        } else if cs[j] == q {
            return j + 1
        } else {
            j = j + 1
        }
    }
    n
}

# The dollar-quote tag opening at `i` ("$$" or "$name$"), or "" when the `$`
# there is not one: `$1` is a parameter, and a `$` inside an identifier
# (`a$b`) is part of the name.
fn dollar_tag(cs, i) {
    n = len(cs)
    if i > 0 and ident_char(cs[i - 1]) { return "" }
    mut j = i + 1
    if j < n and contains(DIGITS, cs[j]) { return "" }
    while j < n and ident_char(cs[j]) {
        j = j + 1
    }
    if j < n and cs[j] == "$" { join(slice(cs, i, j + 1), "") } else { "" }
}

DIGITS = "0123456789"
WORD = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"

# A character that can continue an identifier: ASCII letters, digits and `_`,
# and anything outside ASCII, which Postgres also allows in a name.
fn ident_char(c) = contains(WORD, c) or len(bytes(c)) > 1

# --- transactions ----------------------------------------------------------

# Run one statement on the simple protocol and return its command tag.
fn command(sock, text) {
    send_msg(sock, "Q", bytes(text) + b"\x00")
    r = read_response(sock)
    # 25001: BEGIN inside an open transaction. Postgres only warns and carries
    # on in the outer one, so a nested transaction() would commit its parent.
    if contains(r.notices, "25001") {
        fail("a transaction is already open on this connection; transaction() does not nest")
    }
    r.tag
}

## transaction(db, fn) runs `fn(db)` inside a transaction: it commits when `fn`
## returns, and rolls back and re-raises if `fn` raises. A commit that fails is
## rolled back too, and so is one the server turns into a rollback because a
## statement inside failed; both raise. Returns what `fn` returned.
export fn transaction(sock, body) = in_transaction(fn(text) command(sock, text), fn() body(sock))

## The transaction protocol, over `run(text) -> command tag`. Internal: it is
## exported from this file so the offline tests can drive it without a server.
export fn in_transaction(run, body) {
    run("BEGIN")
    result = try { body() } catch (e) {
        try { run("ROLLBACK") } catch (_) { null }
        error(e)
    }
    tag = try { run("COMMIT") } catch (e) {
        try { run("ROLLBACK") } catch (_) { null }
        error(e)
    }
    # After a failed statement the transaction is aborted, and COMMIT answers
    # ROLLBACK rather than failing.
    if tag == "ROLLBACK" {
        fail(
            "the transaction was rolled back, not committed: a statement inside it failed, so nothing it did was saved",
        )
    }
    result
}
