# Offline tests, run by `ecko test` (no server needed). The full wire protocol
# is exercised by example.ecko against a live server; here we lock down the
# trickiest piece that doesn't need a socket: SCRAM's PBKDF2-HMAC-SHA256, tested
# against the published RFC 6070 / SCRAM vectors.
import std.test
import std.encoding
import std.io
import std.net
import "../client.ecko"

test.case("pbkdf2 matches the known SCRAM-SHA-256 vector", fn() {
    # PBKDF2-HMAC-SHA256("password", "salt", 4096, dkLen=32)
    dk = client.pbkdf2(bytes("password"), bytes("salt"), 4096)
    test.eq(
        encoding.hex_encode(dk),
        "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a",
    )
})

test.case("pbkdf2 at one iteration", fn() {
    dk = client.pbkdf2(bytes("password"), bytes("salt"), 1)
    test.eq(
        encoding.hex_encode(dk),
        "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b",
    )
})

# --- parameterized query (extended protocol) encoding ----------------------

test.case("pg_text renders scalars in Postgres text format", fn() {
    test.eq(client.pg_text(42), "42")
    test.eq(client.pg_text(3.5), "3.5")
    test.eq(client.pg_text("hello"), "hello")
})

test.case("pg_text renders booleans as t/f", fn() {
    test.eq(client.pg_text(true), "t")
    test.eq(client.pg_text(false), "f")
})

test.case("pg_text passes a quote-laden value through verbatim (no escaping)", fn() {
    # Params bind out-of-band, so a value is never parsed as SQL - it needs no
    # escaping, which is exactly what makes this injection-safe.
    test.eq(client.pg_text("Robert'); DROP TABLE students;--"), "Robert'); DROP TABLE students;--")
})

test.case("pg_text renders bytes as a bytea hex literal", fn() {
    test.eq(client.pg_text(b"\x00\xff"), "\\x00ff")
})

test.case("build_bind lays out the extended-protocol Bind message", fn() {
    # Bind for one param "ab": portal "" + stmt "" + Int16 0 (text formats) +
    # Int16 1 (param count) + Int32 2 (len) + "ab" + Int16 0 (result formats).
    got = client.build_bind(["ab"])
    test.eq(got, b"\x00\x00\x00\x00\x00\x01\x00\x00\x00\x02ab\x00\x00")
})

test.case("build_bind encodes a null param as length -1", fn() {
    # null -> Int32 0xFFFFFFFF (no value bytes follow).
    got = client.build_bind([null])
    test.eq(got, b"\x00\x00\x00\x00\x00\x01\xff\xff\xff\xff\x00\x00")
})

# --- error kinds ---------------------------------------------------------------
#
# A failure from the server or the network is `kind: "sql"`, the kind std.sql
# raises, with `driver: "postgres"` and a stable `reason`. A mistake in the
# calling code is `kind: "bug"`, raised at the exported function.

fn kind_of(f) {
    try {
        f()
        null
    } catch (e) { { kind: e.kind, reason: get(e, "reason") } }
}

test.case("a statement that is neither a string nor a sql block is a bug", fn() {
    test.eq(
        kind_of(fn() client.statement("query", 42, [])),
        { kind: "bug", reason: "bad_argument" },
    )
})

# --- `?` placeholders, for sql { } blocks -------------------------------------
#
# A sql { } block is `{ query, params }` with `?` placeholders. Postgres numbers
# its own (`$1`), so a block's `?`s are rewritten - but only real placeholders:
# a `?` in a string, a quoted name, a comment or a dollar-quoted body is text.

test.case("numbered rewrites each ? to the next $n", fn() {
    test.eq(
        client.numbered("select * from t where a = ? and b = ?"),
        { sql: "select * from t where a = $1 and b = $2", count: 2 },
    )
})

test.case(
    "numbered leaves a ? in strings, quoted names and comments alone",
    fn() {
        src = "select '?', 'it''s ?', \"col?\", e'\\'?' from t -- why?\n where a = ? /* or ? */"
        test.eq(
            client.numbered(src),
            {
                sql: "select '?', 'it''s ?', \"col?\", e'\\'?' from t -- why?\n where a = $1 /* or ? */",
                count: 1,
            },
        )
    },
)

test.case("numbered leaves a ? in a dollar-quoted body alone", fn() {
    test.eq(
        client.numbered("select $$a?b$$, $fn$c?$fn$, ?"),
        { sql: "select $$a?b$$, $fn$c?$fn$, $1", count: 1 },
    )
})

test.case("numbered leaves an existing $1 alone", fn() {
    test.eq(client.numbered("select $1"), { sql: "select $1", count: 0 })
})

test.case("a sql block becomes numbered placeholders with its params", fn() {
    name = "Ada"
    id = 7
    got = client.statement(
        "query",
        sql { SELECT * FROM users WHERE name = {name} AND id > {id} },
        [],
    )
    test.eq(got, { sql: "SELECT * FROM users WHERE name = $1 AND id > $2", params: ["Ada", 7] })
})

test.case("a plain string is sent as written, never rewritten", fn() {
    # The string form already uses $n; a ? in it may be a jsonb operator.
    got = client.statement("query", "select data ? 'k' from t where id = $1", [3])
    test.eq(got, { sql: "select data ? 'k' from t where id = $1", params: [3] })
})

test.case("a sql block with a separate params list is refused", fn() {
    x = 1
    test.eq(
        kind_of(fn() client.statement("query", sql { SELECT {x} }, [2])),
        { kind: "bug", reason: "bad_argument" },
    )
})

test.case("a sql block whose ? count does not match its holes is refused", fn() {
    # The jsonb `?` operator reads as a placeholder; refuse rather than misbind.
    k = "key"
    caught = try {
        client.statement("query", sql { SELECT data ? 'x' FROM t WHERE k = {k} }, [])
    } catch (e) {
        e.message
    }
    test.ok(contains(caught, "jsonb"), "should explain the jsonb ? operator: {caught}")
})

# --- transactions -------------------------------------------------------------
#
# transaction(db, fn) behaves like std.sql's: commit when fn returns, roll back
# and re-raise if it raises, and roll back if the commit itself fails. Driven
# through in_transaction with a recording stand-in for the connection: `run`
# takes the statement and returns the server's command tag.

fn recorder(tags) {
    log = cell([])
    run = fn(text) {
        cell_update(log, fn(l) push(l, text))
        get(tags, text) ?? text
    }
    { log: log, run: run }
}

test.case("a transaction commits and returns what the function returned", fn() {
    r = recorder({})
    got = client.in_transaction(r.run, fn() 42)
    test.eq(got, 42)
    test.eq(cell_get(r.log), ["BEGIN", "COMMIT"])
})

test.case("a transaction rolls back and re-raises the function's own error", fn() {
    r = recorder({})
    caught = try {
        client.in_transaction(r.run, fn() error({ kind: "app", message: "no", extra: 1 }))
    } catch (e) {
        e
    }
    test.eq(caught, { kind: "app", message: "no", extra: 1 })
    test.eq(cell_get(r.log), ["BEGIN", "ROLLBACK"])
})

test.case("a commit the server turns into a rollback is an error", fn() {
    # After a failed statement Postgres aborts the transaction, and COMMIT
    # answers with the tag ROLLBACK instead of failing. Reporting success there
    # would claim work was saved when it was thrown away.
    r = recorder({ COMMIT: "ROLLBACK" })
    caught = try {
        client.in_transaction(r.run, fn() 1)
        null
    } catch (e) { e }
    test.eq(caught.kind, "sql")
    test.eq(caught.driver, "postgres")
    test.ok(contains(caught.message, "rolled back"), caught.message)
})

test.case("a commit that fails is rolled back, and its error is the one raised", fn() {
    log = cell([])
    run = fn(text) {
        cell_update(log, fn(l) push(l, text))
        if text == "COMMIT" {
            error({ kind: "sql", driver: "postgres", message: "serialization failure" })
        }
        text
    }
    caught = try {
        client.in_transaction(run, fn() 1)
        null
    } catch (e) { e.message }
    test.eq(caught, "serialization failure")
    test.eq(cell_get(log), ["BEGIN", "COMMIT", "ROLLBACK"])
})

# --- against a scripted server --------------------------------------------------
#
# A loopback listener that plays canned backend messages, one reply per query
# the client sends, so the protocol handling is checked offline. Each reply is
# the exact bytes a real server sends; the queries it saw come back for
# asserting on.

fn be32(n) = bytes([n shr 24 band 255, n shr 16 band 255, n shr 8 band 255, n band 255])
fn be16(n) = bytes([n shr 8 band 255, n band 255])
fn msg(tag, payload) = bytes(tag) + be32(len(payload) + 4) + payload
fn cstr(s) = bytes(s) + b"\x00"

fn complete(tag) = msg("C", cstr(tag))
fn ready() = msg("Z", b"I")
fn failure(code, text) = msg(
    "E",
    b"S" + cstr("ERROR") + b"C" + cstr(code) + b"M" + cstr(text) + b"\x00",
)
fn notice(code, text) = msg(
    "N",
    b"S" + cstr("WARNING") + b"C" + cstr(code) + b"M" + cstr(text) + b"\x00",
)
fn one_row(name, value) {
    desc = msg("T", be16(1) + cstr(name) + bytes(range(0, 18) |> map(fn(_) 0)))
    row = msg("D", be16(1) + be32(len(bytes(value))) + bytes(value))
    desc + row
}

# Serve `replies` in order, one per client message, and return the query text
# of each message received.
async fn scripted(listener, replies) {
    conn = net.accept(listener, 5000)
    mut seen = []
    for reply in replies {
        header = io.read_exact(conn, 5)
        n = header[1] shl 24 bor header[2] shl 16 bor header[3] shl 8 bor header[4]
        body = io.read_exact(conn, n - 4)
        seen = push(seen, string(body[0..len(body) - 1]))
        io.write(conn, reply)
    }
    io.close(conn)
    net.stop(listener)
    seen
}

fn with_server(replies, work) {
    l = net.listen(0, "127.0.0.1")
    server = scripted(l, replies)
    sock = net.connect("127.0.0.1", net.port(l))
    out = try { { value: work(sock) } } catch (e) { { error: e } }
    io.close(sock)
    insert(out, "seen", await server)
}

test.case("a failed query leaves the connection ready for the next one", fn() {
    # The server sends ReadyForQuery after an ErrorResponse. Raising before
    # reading it left it on the socket, and the next query read it as its own
    # (empty) reply.
    got = with_server(
        [
            failure("42P01", "relation \"nope\" does not exist") + ready(),
            one_row("x", "1") + complete("SELECT 1") + ready(),
        ],
        fn(db) {
            first = try { client.query(db, "select * from nope") } catch (e) { e }
            { first: first, second: client.query(db, "select 1 as x") }
        },
    )
    test.eq(got.value.first.kind, "sql")
    test.eq(got.value.first.driver, "postgres")
    test.eq(got.value.first.code, "42P01")
    test.eq(got.value.second, [{ x: "1" }])
})

test.case("a nested transaction is refused, and the outer one rolls back", fn() {
    # BEGIN inside a transaction is only a warning (25001) in Postgres, and the
    # inner COMMIT would then commit the outer transaction's work early.
    got = with_server(
        [
            complete("BEGIN") + ready(),
            notice("25001", "there is already a transaction in progress") +
                complete("BEGIN") +
                ready(),
            complete("ROLLBACK") + ready(),
        ],
        fn(db) client.transaction(db, fn(tx) client.transaction(tx, fn(inner) 1)),
    )
    test.ok(contains(got.error.message, "does not nest"), got.error.message)
    test.eq(got.seen, ["BEGIN", "BEGIN", "ROLLBACK"])
})

test.case("a transaction over the wire sends BEGIN, the work, then COMMIT", fn() {
    got = with_server(
        [
            complete("BEGIN") + ready(),
            complete("INSERT 0 1") + ready(),
            complete("COMMIT") + ready(),
        ],
        fn(db) client.transaction(db, fn(tx) {
            client.query(tx, "insert into t values (1)")
            "done"
        }),
    )
    test.eq(got.value, "done")
    test.eq(got.seen, ["BEGIN", "insert into t values (1)", "COMMIT"])
})

# --- a parameterized query goes out in one write ----------------------------
#
# Parse, Bind, Describe, Execute and Sync used to be five separate writes. Small
# consecutive writes on a TCP socket meet Nagle's algorithm and the server's
# delayed ACK, which stalled every parameterized query for about 40 ms.

test.case("extended_request is Parse, Bind, Describe, Execute and Sync back to back", fn() {
    got = client.extended_request("select $1", [7])
    want = msg("P", b"\x00" + cstr("select $1") + be16(0)) +
        msg("B", b"\x00\x00" + be16(0) + be16(1) + be32(1) + b"7" + be16(0)) +
        msg("D", b"P\x00") +
        msg("E", b"\x00" + be32(0)) +
        msg("S", b"")
    test.eq(got, want)
})

# Read once, the way a server sees the first segment, then answer the query.
async fn first_read(listener) {
    conn = net.accept(listener, 5000)
    got = io.read(conn, 65536)
    io.write(conn, one_row("v", "8") + complete("SELECT 1") + ready())
    io.close(conn)
    net.stop(listener)
    got
}

test.case("a parameterized query reaches the server as one write", fn() {
    l = net.listen(0, "127.0.0.1")
    server = first_read(l)
    sock = net.connect("127.0.0.1", net.port(l))
    rows = client.query(sock, "select $1::int + 1 as v", [7])
    io.close(sock)
    # One write lands whole in the server's first read. With five writes the
    # first read often held only some of them; that is timing, so this case
    # catches the old code only sometimes, and the exact-bytes case above is
    # the deterministic check of the request itself.
    test.eq(await server, client.extended_request("select $1::int + 1 as v", [7]))
    test.eq(rows, [{ v: "8" }])
})

# --- parameters the client cannot send as text ---------------------------------

test.case("a secret parameter is revealed on the wire, not sent as [secret]", fn() {
    test.eq(client.pg_text(secret("tok")), "tok")
    got = client.build_bind([secret("ab")])
    test.eq(got, b"\x00\x00\x00\x00\x00\x01\x00\x00\x00\x02ab\x00\x00")
})

test.case("a list or map parameter is refused, not sent as display text", fn() {
    test.eq(kind_of(fn() client.pg_text([1, 2])), { kind: "bug", reason: "bad_argument" })
    test.eq(kind_of(fn() client.pg_text({ a: 1 })), { kind: "bug", reason: "bad_argument" })
    test.eq(kind_of(fn() client.build_bind([[1]])), { kind: "bug", reason: "bad_argument" })
})

test.case("a decimal parameter is sent exactly", fn() {
    test.eq(client.pg_text(19.99m), "19.99")
})

# --- connecting ----------------------------------------------------------------

test.case("the startup message asks for UTF-8 and names the database", fn() {
    body = be32(196608) +
        cstr("user") +
        cstr("app") +
        cstr("client_encoding") +
        cstr("UTF8") +
        cstr("database") +
        cstr("shop") +
        b"\x00"
    test.eq(client.startup_message("app", "shop"), be32(len(body) + 4) + body)
})

test.case("the startup message leaves the database out when none is given", fn() {
    body = be32(196608) +
        cstr("user") +
        cstr("app") +
        cstr("client_encoding") +
        cstr("UTF8") +
        b"\x00"
    test.eq(client.startup_message("app", null), be32(len(body) + 4) + body)
})

test.case("connect takes named arguments; the old map form is a bug", fn() {
    caught = try {
        client.connect({ host: "127.0.0.1", port: 5432 }, "u")
        null
    } catch (e) { e }
    test.eq(caught.kind, "bug")
    test.eq(caught.reason, "bad_argument")
    test.ok(contains(caught.message, "named arguments"), caught.message)
    test.eq(
        kind_of(fn() client.connect("h", "u", port: "5432")),
        { kind: "bug", reason: "bad_argument" },
    )
    test.eq(
        kind_of(fn() client.connect("h", "u", password: 5)),
        { kind: "bug", reason: "bad_argument" },
    )
})

# Answer the startup packet with `reply` and return what the client sent.
async fn login_server(listener, reply) {
    conn = net.accept(listener, 5000)
    header = io.read_exact(conn, 4)
    n = header[0] shl 24 bor header[1] shl 16 bor header[2] shl 8 bor header[3]
    body = io.read_exact(conn, n - 4)
    io.write(conn, reply)
    # Wait for the client to hang up (or the next message).
    rest = try { io.read(conn, 1) } catch (_) { null }
    io.close(conn)
    net.stop(listener)
    { body: body, rest: rest }
}

fn login(reply, password = null, database = null) {
    l = net.listen(0, "127.0.0.1")
    server = login_server(l, reply)
    out = try {
        db = client.connect(
            "127.0.0.1",
            "app",
            password: password,
            database: database,
            port: net.port(l),
        )
        client.close(db)
        { value: "ok" }
    } catch (e) { { error: e } }
    insert(out, "seen", await server)
}

fn auth(code) = msg("R", be32(code))

test.case("trust auth needs no password and no database", fn() {
    got = login(auth(0) + msg("S", cstr("client_encoding") + cstr("UTF8")) + ready())
    test.eq(got.value, "ok")
    test.ok(not contains(string(got.seen.body), "database"), "no database param was sent")
})

test.case("a server asking for a password when none was given is auth_failed", fn() {
    got = login(auth(10) + msg("R", be32(10) + cstr("SCRAM-SHA-256") + b"\x00"))
    test.eq(got.error.kind, "sql")
    test.eq(got.error.reason, "auth_failed")
    test.eq(got.seen.rest, null)
})

test.case("an unsupported auth method names its code", fn() {
    got = login(auth(5) + b"salt", password: "pw")
    test.eq(got.error.reason, "auth_unsupported")
    test.ok(contains(got.error.message, "auth code 5"), got.error.message)
})

test.case("a refused login is a server_error carrying the SQLSTATE", fn() {
    got = login(failure("28P01", "password authentication failed"), password: "pw")
    test.eq(got.error.kind, "sql")
    test.eq(got.error.reason, "server_error")
    test.eq(got.error.code, "28P01")
})

# --- reading replies -----------------------------------------------------------

fn columns(names) = msg(
    "T",
    be16(len(names)) +
        reduce(names, fn(acc, n) acc + cstr(n) + bytes(range(0, 18) |> map(fn(_) 0)), b""),
)

fn data_row(values) = msg(
    "D",
    be16(len(values)) +
        reduce(values, fn(acc, v) if is_null(v) { acc + b"\xff\xff\xff\xff" } else { acc + be32(len(v)) + v }, b""),
)

test.case("two result columns with one name are an error, and the connection survives", fn() {
    got = with_server(
        [
            columns(["id", "id"]) + data_row([b"1", b"2"]) + complete("SELECT 1") + ready(),
            one_row("x", "1") + complete("SELECT 1") + ready(),
        ],
        fn(db) {
            first = try { client.query(db, "select a.id, b.id from a, b") } catch (e) { e }
            { first: first, second: client.query(db, "select 1 as x") }
        },
    )
    test.eq(got.value.first.kind, "sql")
    test.eq(got.value.first.reason, "duplicate_column")
    test.ok(contains(got.value.first.message, "'id'"), got.value.first.message)
    test.eq(got.value.second, [{ x: "1" }])
})

test.case("a value that is not UTF-8 comes back as bytes", fn() {
    got = with_server(
        [columns(["v", "n"]) + data_row([b"\xff\xfe", null]) + complete("SELECT 1") + ready()],
        fn(db) client.query(db, "select v, n from t"),
    )
    test.eq(got.value, [{ v: b"\xff\xfe", n: null }])
})

test.case("a truncated row is a protocol error, not a crash", fn() {
    got = with_server(
        [columns(["v"]) + msg("D", be16(1) + be32(10) + b"abc") + complete("SELECT 1") + ready()],
        fn(db) client.query(db, "select v from t"),
    )
    test.eq(got.error.kind, "sql")
    test.eq(got.error.reason, "protocol")
})

test.case("exec returns the affected-row count from the command tag", fn() {
    got = with_server(
        [
            complete("INSERT 0 3") + ready(),
            complete("UPDATE 2") + ready(),
            complete("CREATE TABLE") + ready(),
        ],
        fn(db) [
            client.exec(db, "insert into t select generate_series(1, 3)"),
            client.exec(db, "update t set a = 1 where a > 1"),
            client.exec(db, "create table u (a int)"),
        ],
    )
    test.eq(got.value, [3, 2, 0])
})

test.case("affected reads the count from every tag shape", fn() {
    test.eq(client.affected("INSERT 0 5"), 5)
    test.eq(client.affected("DELETE 0"), 0)
    test.eq(client.affected("SELECT 12"), 12)
    test.eq(client.affected("BEGIN"), 0)
    test.eq(client.affected(""), 0)
})

# --- TLS -----------------------------------------------------------------------

async fn ssl_server(listener, answer) {
    conn = net.accept(listener, 5000)
    got = io.read_exact(conn, 8)
    io.write(conn, answer)
    rest = try { io.read(conn, 1) } catch (_) { null }
    io.close(conn)
    net.stop(listener)
    { got: got, rest: rest }
}

test.case("connect_tls asks with SSLRequest and reports a refusal", fn() {
    l = net.listen(0, "127.0.0.1")
    server = ssl_server(l, b"N")
    caught = try {
        client.connect_tls("127.0.0.1", "app", port: net.port(l))
        null
    } catch (e) { e }
    seen = await server
    test.eq(seen.got, b"\x00\x00\x00\x08\x04\xd2\x16\x2f")
    test.eq(seen.rest, null)
    test.eq(caught.kind, "sql")
    test.eq(caught.reason, "tls_refused")
})
